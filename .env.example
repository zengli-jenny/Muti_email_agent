# LLM Configuration (Dashscope/Qwen example)
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=qwen3.5-plus
LLM_TEMPERATURE=0.1

# TCS API Configuration
TCS_BASE_URL=https://tcs.1000shores.cn
TCS_TOKEN=your_tcs_token_here

# Knowledge Base Configuration
KNOWLEDGE_BASE_PATH=./knowledge_base_full.json
POLICY_DIR=./标准流程

# Service Configuration
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000

# ReAct Configuration
MAX_REACT_ITERATIONS=7
MAX_REFLECTIONS=2

# Mock Mode (for testing without real APIs)
USE_MOCK_TCS=false
